using io

const Void EMPTY = ()

reset(ref void value);
	value = EMPTY

identity(value) = value

int main();
	str text = "A🇯🇵é👩🏽‍💻"
	char letter = text[2]
	io.print("{text.length} {letter.length}")
	text[1] = "👍🏽"
	io.print(text)
	void values[3] = [EMPTY]
	reset(ref values[0])
	io.print(identity(values))
	return 0
