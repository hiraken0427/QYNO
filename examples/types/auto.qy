using io

model Point;
	int x
	int y

Point origin() = {x=3, y=4}

int main();
	auto count = 3
	auto ratio = 0.5
	auto title = "QYNO"
	auto enabled = true
	auto matrix = [[1, 2], [3, 4]]
	const auto LIMIT = 10
	auto point = origin()
	auto copied = matrix
	copied[0][0] = 9
	io.print("{title}: {count} {ratio} {enabled} {LIMIT}")
	io.print(matrix)
	io.print(copied)
	io.print("{point.x}, {point.y}")
	return 0
