import settings
using settings as cfg

const SIZE = cfg.LIMIT
const auto LABEL = cfg.LABEL + " constants"

model Point;
	int x = SIZE
	int y = cfg.BASE

const ORIGIN = Point()

int main();
	int values[SIZE]
	point = ORIGIN
	point.x++
	io.print("{LABEL}: {values.length}")
	io.print(cfg.MATRIX)
