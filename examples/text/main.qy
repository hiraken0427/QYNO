using io

int main();
	str lines[] = ["  report.txt = ready  ", "# ignored", " image.png = missing ", "notes.txt=ready"]
	int ready = 0
	for(0 <= i < lines.length, i++);
		str line = lines[i].trim()
		if(line.starts_with("#") or not line.contains("="));
			continue
		str fields[] = line.split("=")
		if(fields.length != 2);
			continue
		str name = fields[0].trim()
		str status = fields[1].trim()
		if(name.ends_with(".txt") and status == "ready");
			ready++
			print(name.replace(".txt", ".bak"))
		print("separator at {line.find("=")}: {name} / {status}")
	print("Ready text files: {ready}")
	return 0
