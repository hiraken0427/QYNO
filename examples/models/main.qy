// QYNO 0.26.0: model・名前付き初期化子・コピーと参照の実行例。

model Point;
	double x = 0.0
	double y = 0.0

	void move(double dx, double dy);
		this.x += dx
		this.y += dy

	double distance();
		return math.sqrt(this.x^2 + this.y^2)

model Rectangle;
	Point position
	double width = 0.0
	double height = 0.0

	void move(double dx, double dy);
		this.position.move(dx, dy)

	double area();
		return this.width * this.height

void show_point(str label, Point point);
	io.print("{label}: ({point.x}, {point.y})")

void move_copy(Point point);
	point.move(100.0, 100.0)

void move_original(ref Point point);
	point.move(1.0, 1.0)

int main();
	// 既定値・名前付き初期化・一部フィールドの省略。
	Point origin
	Point p = {x=3.0, y=4.0}
	Point horizontal = {x=10.0}
	show_point("origin", origin)           // (0, 0)
	show_point("p", p)                     // (3, 4)
	show_point("horizontal", horizontal)   // (10, 0)
	io.print("distance: {p.distance()}")    // 5

	// 通常の代入は独立した値を作る。
	Point copy = p
	copy.move(10.0, 0.0)
	show_point("p", p)                     // (3, 4)
	show_point("copy", copy)               // (13, 4)

	// ref は p という変数の場所を共有する。
	ref Point shared = p.addr
	shared.move(1.0, 2.0)
	show_point("p", p)                     // (4, 6)
	p = {x=20.0, y=30.0}
	show_point("shared", shared)           // (20, 30)

	// 通常の引数はコピー、ref 引数は呼び出し元を更新する。
	move_copy(p)
	show_point("p after value call", p)     // (20, 30)
	move_original(ref p)
	show_point("p after ref call", p)       // (21, 31)

	// 要素の型 Point から、それぞれの初期化子の型を決める。
	Point points[] = [
		{x=1.0, y=2.0},
		{x=3.0, y=4.0}
	]
	for(0 <= i < points.length, i++);
		points[i].move(1.0, 0.0)
		show_point("point", points[i])       // (2, 2)、(4, 4)

	// 入れ子の初期化子は、position フィールドの型 Point で生成する。
	Rectangle rect = {
		position={x=1.0, y=2.0},
		width=10.0,
		height=20.0
	}
	rect.move(5.0, 6.0)
	show_point("rectangle position", rect.position)  // (6, 8)
	io.print("area: {rect.area()}")                 // 200

	// 初期化子による再代入は、新しい値への置き換え。
	// 指定していない y は既定値の 0.0 に戻る。
	p = {x=5.0}
	show_point("p after replacement", p)    // (5, 0)

	// 一部だけ変更する場合は、フィールドへ代入する。
	p.y = 7.0
	p.x = 8.0
	show_point("p after field assignment", p)  // (8, 7)

	return 0
