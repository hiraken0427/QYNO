using io
using time

int main();
	DateTime appointment = {year=2026, month=10, day=29, hour=9, minute=30, second=0.125, offset_minutes=540}
	print(isoformat(to_timestamp(appointment), 540))
	print(weekday(appointment))
	Stopwatch watch
	watch.start()
	sleep(milliseconds(2))
	print("lap: {in_milliseconds(watch.lap())} ms")
	sleep(milliseconds(3))
	print("total: {format_duration(watch.stop())}")
	return 0
