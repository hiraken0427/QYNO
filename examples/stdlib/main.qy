using io
using lib
using io.path as path

int main();
	int matrix[2][3] = [[1, 2, 3], [4, 5, 6]]
	str text = "A🇯🇵é"
	print("matrix: {size(matrix)} bits, rows={length(matrix)}")
	print("row: {size(matrix[0])} bits, element: {size(matrix[0][0])} bits")
	print("text: {length(text)} graphemes, {size(text)} bits")
	print("digits: {length(-42)}, {length(3.1415)}")
	str filename = path.join("data", "settings.json")
	print(path.basename(filename))
	print(path.with_extension(filename, ".bak"))
	return 0
