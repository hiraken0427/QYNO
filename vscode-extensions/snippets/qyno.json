{
  "Main": {
    "prefix": "main",
    "body": [
      "int main();",
      "\t$0",
      "\treturn 0"
    ],
    "description": "エントリ関数"
  },
  "Forward loop": {
    "prefix": "for",
    "body": [
      "for(0 <= ${1:i} < ${2:count}, ${1:i}++);",
      "\t$0"
    ],
    "description": "半開区間の昇順ループ"
  },
  "Reverse loop": {
    "prefix": "forrev",
    "body": [
      "for(${1:count} > ${2:i} >= 0, ${2:i}--);",
      "\t$0"
    ],
    "description": "半開区間の降順ループ"
  },
  "Function": {
    "prefix": "fn",
    "body": [
      "${1:void} ${2:name}(${3});",
      "\t$0"
    ],
    "description": "関数を定義"
  },
  "If": {
    "prefix": "if",
    "body": [
      "if(${1:condition});",
      "\t$0"
    ],
    "description": "条件分岐"
  },
  "While": {
    "prefix": "while",
    "body": [
      "while(${1:condition});",
      "\t$0"
    ],
    "description": "繰り返し"
  },
  "Using alias": {
    "prefix": "usingalias",
    "body": [
      "using ${1:io.file} as ${2:fs}"
    ],
    "description": "モジュールの別名"
  },
  "Read file": {
    "prefix": "fileread",
    "body": [
      "file ${1:source} = io.file.open(${2:\"input.txt\"}, \"r\")",
      "str ${3:line}",
      "while(io.file.readline(${1:source}, ref ${3:line}));",
      "\tio.print(${3:line})",
      "io.file.close(${1:source})",
      "$0"
    ],
    "description": "UTF-8を行ごとに読み、明示的に閉じる"
  },
  "Write file": {
    "prefix": "filewrite",
    "body": [
      "file ${1:destination} = io.file.open(${2:\"output.txt\"}, \"w\")",
      "io.file.write(${1:destination}, ${3:\"text\"})",
      "io.file.close(${1:destination})",
      "$0"
    ],
    "description": "UTF-8を書き込み、明示的に閉じる"
  },
  "Model": {
    "prefix": "model",
    "body": [
      "model ${1:Point};",
      "\tdouble x = 0.0",
      "\tdouble y = 0.0",
      "",
      "\tvoid move(double dx, double dy);",
      "\t\tthis.x += dx",
      "\t\tthis.y += dy",
      "$0"
    ],
    "description": "値としてコピーされるモデル型"
  },
  "Readonly method": {
    "prefix": "readonlymethod",
    "body": [
      "public readonly ${1:double} ${2:distance}();",
      "\treturn ${3:this.x}",
      "$0"
    ],
    "description": "this を変更しないメソッド"
  },
  "Readonly reference function": {
    "prefix": "readonlyref",
    "body": [
      "${1:int} ${2:total}(ref readonly ${3:int} ${4:items}[]);",
      "\t${0:return items.length}"
    ],
    "description": "配列をコピーせず読み取り専用で受け取る関数"
  },
  "Initializer": {
    "prefix": "init",
    "body": [
      "public void init(${1:int initial});",
      "\t${2:this.count = initial}",
      "$0"
    ],
    "description": "モデル生成時にだけ実行する初期化処理"
  },
  "Checked initializer": {
    "prefix": "checkedinit",
    "body": [
      "public bool init(${1:int initial});",
      "\tif(${2:initial < 0});",
      "\t\treturn false",
      "\t${3:this.count = initial}",
      "\treturn true",
      "$0"
    ],
    "description": "入力検証と生成拒否を持つ初期化処理"
  },
  "Interface contract": {
    "prefix": "interface",
    "body": [
      "interface ${1:Shape};",
      "\treadonly ${2:double} ${3:area}();"
    ],
    "description": "Borrowed interface contract"
  },
  "Enum": {
    "prefix": "enum",
    "body": [
      "enum ${1:State};",
      "\t${2:undetermined}",
      "\t${3:ready}"
    ],
    "description": "独立した列挙型。先頭は既定値0"
  },
  "Enum match": {
    "prefix": "match",
    "body": [
      "match(${1:value});",
      "\tcase ${2:member};",
      "\t\t$0",
      "\telse;",
      "\t\treturn"
    ],
    "description": "enumの分岐。全件列挙またはelseが必要"
  }
}
