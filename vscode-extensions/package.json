{
  "name": "qyno-vscode",
  "displayName": "QYNO 0.27.5",
  "description": "QYNO 0.27.5: highlighting, completions, navigation, automatic indentation and compiler diagnostics.",
  "version": "0.27.5",
  "publisher": "hiraken0427",
  "author": "hiraken0427",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/hiraken0427/QYNO.git",
    "directory": "vscode-extensions"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "QYNO",
    "qy",
    "language"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onLanguage:qyno"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "qyno",
        "aliases": [
          "QYNO",
          "qyno"
        ],
        "extensions": [
          ".qy"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "qyno",
        "scopeName": "source.qyno",
        "path": "./syntaxes/qyno.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "qyno",
        "path": "./snippets/qyno.json"
      }
    ],
    "configurationDefaults": {
      "[qyno]": {
        "editor.insertSpaces": false,
        "editor.tabSize": 4,
        "editor.detectIndentation": false,
        "editor.wordBasedSuggestions": "off",
        "editor.quickSuggestions": {
          "other": true,
          "comments": false,
          "strings": true
        }
      }
    },
    "configuration": {
      "title": "QYNO",
      "properties": {
        "qyno.entryFile": {
          "type": "string",
          "default": "",
          "description": "Entry .qy file, relative to the workspace folder or an absolute path. Empty uses the active file's directory as the import root."
        },
        "qyno.moduleRoots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional module roots in -I order, relative to the workspace folder or absolute paths."
        },
        "qyno.maxIndexedFiles": {
          "type": "integer",
          "default": 2000,
          "minimum": 1,
          "maximum": 10000,
          "description": "Maximum .qy files scanned for import suggestions."
        },
        "qyno.diagnostics.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Check QYNO sources with qyc while editing. Requires a trusted workspace and a local compiler. Programs are never executed."
        },
        "qyno.compilerPath": {
          "type": "string",
          "default": "qyc",
          "scope": "machine-overridable",
          "restricted": true,
          "description": "Path to the QYNO 0.27.5 qyc executable (qyc.exe on Windows). Relative paths use the workspace folder. No shell arguments."
        },
        "qyno.diagnostics.delay": {
          "type": "integer",
          "default": 500,
          "minimum": 100,
          "maximum": 10000,
          "description": "Milliseconds to wait after edits before checking with qyc."
        }
      }
    },
    "commands": [
      {
        "command": "qyno.checkDocument",
        "title": "QYNO: Check Current File"
      }
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node --check src/extension.js && node --check src/analysis.js && node --check src/language.js && node --check src/initialization.js && node --check src/diagnostics.js",
    "test:editor": "node test/run-editor.js",
    "package": "vsce package --skip-license --baseContentUrl https://github.com/hiraken0427/QYNO/blob/dev/vscode-extensions --out 0.27.5_VSCode_option.vsix"
  },
  "devDependencies": {
    "@vscode/vsce": "4.0.0",
    "@vscode/test-electron": "2.5.2",
    "vscode-textmate": "9.3.2",
    "vscode-oniguruma": "2.0.1"
  }
}
